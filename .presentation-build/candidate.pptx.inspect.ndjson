{"kind":"textbox","id":"sh/u9wzul8b","slideIndex":1,"position":{"left":76,"top":284,"width":900,"height":40},"text":"I calculated four views of the data:","geometry":"rect","lineWidth":0,"style":{"fontSize":26,"typeface":"Aptos","color":"#17324D","bold":true,"alignment":"left"}}
